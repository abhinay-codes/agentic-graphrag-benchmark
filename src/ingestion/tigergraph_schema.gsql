USE GLOBAL

CREATE VERTEX Document (
    PRIMARY_ID doc_id STRING,
    title STRING,
    url STRING,
    wikipedia_pageid INT
) WITH PRIMARY_ID_AS_ATTRIBUTE="true"

CREATE VERTEX Chunk (
    PRIMARY_ID chunk_id STRING,
    text STRING,
    chunk_index INT
) WITH PRIMARY_ID_AS_ATTRIBUTE="true"

CREATE VERTEX Entity (
    PRIMARY_ID wikidata_qid STRING
) WITH PRIMARY_ID_AS_ATTRIBUTE="true"

CREATE DIRECTED EDGE HAS_CHUNK (
    FROM Document,
    TO Chunk
)

CREATE DIRECTED EDGE ABOUT_ENTITY (
    FROM Document,
    TO Entity
)

CREATE GLOBAL SCHEMA_CHANGE JOB add_graphrag_schema {
    ADD VERTEX Document TO GRAPH GRAPHRAG;
    ADD VERTEX Chunk TO GRAPH GRAPHRAG;
    ADD VERTEX Entity TO GRAPH GRAPHRAG;
    ADD EDGE HAS_CHUNK TO GRAPH GRAPHRAG;
    ADD EDGE ABOUT_ENTITY TO GRAPH GRAPHRAG;
}

RUN GLOBAL SCHEMA_CHANGE JOB add_graphrag_schema
